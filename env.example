# Файл: MOEX_BOT/.env.example
# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# MOEX API
MOEX_API_TIMEOUT=30

# Модели
MODEL_DIR=/app/models
DEFAULT_MODEL_PATH=/app/models/reg.model

# Задачи
MAX_CONCURRENT_TASKS=10
PAUSE_1M=60
PAUSE_10M=600

# Логирование
LOG_LEVEL=INFO

# Агент (read-only пользователь)
AGENT_READONLY_USER=agent_ro
AGENT_READONLY_PASSWORD=secure_pass